  "footnotes": [
    {
      "marker": "*",
      "text": "Baseline assessments must occur within 2 weeks during the screening period. The screening period is within 4 weeks of subject enrollment. Baseline and screening period may occur simultaneously.",
      "appears_complete": true,
      "attaches_to": [
        {
          "kind": "column",
          "column": 1
        }
      ]
    },
    {
      "marker": "a",
      "text": "Blood is collected in fasted state at least once (preferably twice) before investigational agent administration, once during weeks 3-6, and once at week 12 or at final visit if subject discontinues prematurely. The two specimens prior to investigational agent may be drawn during baseline, or one may be drawn during baseline and one on study day 1 prior to administration of first dose of investigational agent.",
      "appears_complete": true,
      "attaches_to": []
    },
    {
      "marker": "b",
      "text": "Once during the week preferably at the first visit of the week.",
      "appears_complete": true,
      "attaches_to": []
    },
    {
      "marker": "c",
      "text": "At the final scheduled study visit (last visit of week 12) or if the subjects discontinues prematurely.",
      "appears_complete": true,
      "attaches_to": []
    },
    {
      "marker": "d",
      "text": "FEV1 is only performed in those subjects suspected of having asthma.",
